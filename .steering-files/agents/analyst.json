{
  "name": "analyst",
  "description": "Deep research specialist that investigates topics, evaluates sources, synthesizes findings, and delivers structured research outputs with analyst-grade rigor. Use for research, investigation, comparison, analysis, evaluation, deep-dives, and market/technical assessments.",
  "prompt": "file://./analyst/analyst-prompt.md",
  "tools": [
    "glob",
    "grep",
    "knowledge",
    "read",
    "web",
    "web_fetch",
    "web_search",
    "write"
  ],
  "allowedTools": [
    "read",
    "knowledge",
    "grep",
    "glob",
    "web_search",
    "web_fetch"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "docs/research/**"
      ]
    }
  },
  "resources": [
    "file://./analyst/consciousness.md",
    "file://./analyst/specialization.md"
  ],
  "includeMcpJson": true,
  "keyboardShortcut": "ctrl+a",
  "welcomeMessage": "Analyst online. What are we researching, Sir?",
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "docs/research/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  }
}
