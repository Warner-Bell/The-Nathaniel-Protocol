# ===========================================
# Nathaniel Protocol .gitignore
# ===========================================

# Kiro runtime config (deployed from .steering-files by setup.sh)
.kiro/
.kiro.backup-*/

# Kiro memory (may contain session-specific data)
.steering-files/memory.jsonl

# Claude
.claude/
CLAUDE.md
CLAUDE.md.backup-*

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# Node
node_modules/

# Secrets & Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json
credentials.json
# Credential stores: any directory named .secrets, at any depth (see security-protocol.md section 2).
# The card registry (Nate's-kb/credential-registry.json) is metadata only and stays tracked.
.secrets/
*.json.lock
Nate's-kb/credential-registry.json.lock

# Hook runtime ledgers (regenerated locally)
scripts/hooks/skill-router-events.jsonl

# IDE & Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Temporary
*.tmp
*.swp
*.bak
*.log

# Vectorstore (generated, rebuildable)
Nate's-kb/vectorstore/vectors.npy
Nate's-kb/vectorstore/metadata.json
Nate's-kb/vectorstore/config.json

# Hypothesis test cache
Nate's-kb/vectorstore/.hypothesis/
.pytest_cache/
Nate's-kb/vectorstore/.access_hits.json
